datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────
// Enumerationen
// ─────────────────────────────────────────────

enum DocumentStatus {
  Draft
  In_Review
  In_Approval
  Released
  Archived
  Withdrawn
  Destroyed
}

enum WorkflowTaskType {
  Review
  Approval
}

enum WorkflowTaskStatus {
  Pending
  Approved
  Rejected
  Cancelled
}

enum TrainingStatus {
  Assigned
  Completed
  // 'Overdue' wird berechnet (dueDate < heute && Assigned), nicht gespeichert
}

// ─────────────────────────────────────────────
// Organisation
// ─────────────────────────────────────────────

// Abteilungsbaum: parentId = übergeordnete Abteilung (beliebig tief)
model Department {
  id              String                     @id @default(cuid())
  parentId        String?
  parent          Department?                @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        Department[]               @relation("DepartmentTree")
  name            String
  abbreviation    String?
  description     String?
  quorumMode      String?                    // "einer" | "alle", null = App-Standard
  users           User[]
  scopedDocuments ScopeDepartment[]
  documents       Document[]
  leads           DepartmentLead[]
  roleAssignments DepartmentRoleAssignment[]
}

model DepartmentLead {
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([departmentId, userId])
}

model DepartmentRoleAssignment {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String     // ERSTELLER, PRUEFER, FREIGEBER (lib/constants.ts)
  createdAt    DateTime   @default(now())

  @@unique([departmentId, userId, role])
}

model JobRole {
  id              String         @id @default(cuid())
  name            String         @unique
  description     String?
  users           User[]
  scopedDocuments ScopeJobRole[]
}

// Systemrolle (ADMIN, EDITOR, VIEWER …)
model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String
  users       User[]
}

model User {
  id       String  @id @default(cuid())
  username String? @unique
  email    String  @unique
  password String // bcrypt-Hash
  name     String?
  isActive Boolean @default(true)
  isExternal Boolean @default(false)
  theme      String  @default("hell")
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  roleId       String?
  role         Role?       @relation(fields: [roleId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  jobRoleId    String?
  jobRole      JobRole?    @relation(fields: [jobRoleId], references: [id])

  departmentLeads           DepartmentLead[]
  departmentRoleAssignments DepartmentRoleAssignment[]

  ownedDocuments  Document[]        @relation("DocumentOwner")
  createdVersions DocumentVersion[] @relation("VersionCreator")
  reviewedVersions DocumentVersion[] @relation("VersionReviewer")
  approvedVersions DocumentVersion[] @relation("VersionApprover")
  workflowTasks   WorkflowTask[]    @relation("TaskAssignee")
  trainingRecords TrainingRecord[]
  auditLogs       AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fileAssets    FileAsset[]
  createdUses   FileAssetUse[]    @relation("UseCreator")
  destructionRequestsRequested DestructionRequest[] @relation("DestructionRequester")
  destructionRequestsConfirmed DestructionRequest[] @relation("DestructionConfirmer")
}

// ─────────────────────────────────────────────
// Dokumentenkern
// ─────────────────────────────────────────────

model DocumentType {
  id               String     @id @default(cuid())
  name             String     @unique
  requiresTraining Boolean    @default(false)
  defaultVisibility String    @default("PUBLIC")
  retentionMonths   Int       @default(120)
  documents        Document[]
}

model Document {
  id             String            @id @default(cuid())
  documentNumber String            @unique
  typeId         String?
  type           DocumentType?     @relation(fields: [typeId], references: [id])
  departmentId   String?
  department     Department?       @relation(fields: [departmentId], references: [id])
  ownerId        String?
  owner          User?             @relation("DocumentOwner", fields: [ownerId], references: [id])
  reviewIntervalMonths Int?
  isTemplate     Boolean           @default(false)
  versions       DocumentVersion[]
  createdAt      DateTime          @default(now())
}

model DocumentVersion {
  id            String             @id @default(cuid())
  documentId    String
  document      Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  majorVersion  Int
  minorVersion  Int
  title         String
  content       String? // TipTap JSON/HTML (Editor-Dokumente)
  filePath      String? // Upload-Dateien (Formblätter, Prüfprotokolle …)
  changeReason  String?
  status        DocumentStatus     @default(Draft)
  visibility    String             @default("PUBLIC")
  effectiveDate DateTime?
  obsoleteDate  DateTime?
  nextReviewDate DateTime?
  retentionEndDate DateTime?
  createdAt     DateTime           @default(now())
  createdById   String?
  createdBy     User?              @relation("VersionCreator", fields: [createdById], references: [id])

  // Workflow-Zuordnung: Wer prüft (Review), wer gibt frei (Approval).
  reviewerId String?
  reviewer   User? @relation("VersionReviewer", fields: [reviewerId], references: [id])
  approverId String?
  approver   User? @relation("VersionApprover", fields: [approverId], references: [id])

  scopeDepartments ScopeDepartment[]
  scopeJobRoles    ScopeJobRole[]
  workflowTasks    WorkflowTask[]
  trainingRecords  TrainingRecord[]
  fileAssetUses    FileAssetUse[]
  destructionRequests DestructionRequest[]

  @@unique([documentId, majorVersion, minorVersion])
}

// ─────────────────────────────────────────────
// Geltungsbereich (Scope)
// ─────────────────────────────────────────────

// Scope expandiert nach unten: Abteilung + alle Unterabteilungen (Entscheidung 31.08.2026)
model ScopeDepartment {
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  departmentId      String
  department        Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([documentVersionId, departmentId])
}

model ScopeJobRole {
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  jobRoleId         String
  jobRole           JobRole         @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)

  @@id([documentVersionId, jobRoleId])
}

// ─────────────────────────────────────────────
// Workflow (Review → Approval)
// ─────────────────────────────────────────────

model WorkflowTask {
  id                String             @id @default(cuid())
  documentVersionId String
  documentVersion   DocumentVersion    @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  assignedToId      String?
  assignedTo        User?              @relation("TaskAssignee", fields: [assignedToId], references: [id])
  taskType          WorkflowTaskType
  status            WorkflowTaskStatus @default(Pending)
  comments          String?
  createdAt         DateTime           @default(now())
  completedAt       DateTime?
}

// ─────────────────────────────────────────────
// Schulungs-Nachverfolgung
// ─────────────────────────────────────────────

// Eine Zeile pro (Dokumentversion, User): „Wer muss die Schulung machen“ → „Wer hat sie erledigt“
model TrainingRecord {
  id                  String          @id @default(cuid())
  documentVersionId   String
  documentVersion     DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status              TrainingStatus  @default(Assigned)
  assignedAt          DateTime        @default(now())
  dueDate             DateTime
  completedAt         DateTime?
  // Nachweis: Name, Zeitstempel, gelesene Version (JSON)
  electronicSignature Json?

  @@unique([documentVersionId, userId])
}

// ─────────────────────────────────────────────
// Audit-Trail (vollumfänglich)
// ─────────────────────────────────────────────

// Protokolliert ALLE Änderungen: wer, wann, was (vorher/nachher)
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // CREATE, UPDATE, STATUS_CHANGE, RELEASE, APPROVE, REJECT, ASSIGN_TRAINING, COMPLETE_TRAINING, …
  entityType String // Document, DocumentVersion, WorkflowTask, TrainingRecord, Scope, User, Department …
  entityId   String
  before     Json? // Zustand vor der Änderung
  after      Json? // Zustand nach der Änderung
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// Einstellungen (Key-Value — Liste wächst dynamisch)
// ─────────────────────────────────────────────

// Zentrale App-Einstellungen, z. B. auth.mode (standalone|ldap),
// company.name, training.defaultDueDays … Änderungen laufen über den Audit-Log
// (entityType "AppSetting", entityId = key).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Uploads / Mediathek (Runde 6)
// ─────────────────────────────────────────────

model FileAsset {
  id           String         @id @default(uuid())
  ownerId      String?
  owner        User?          @relation(fields: [ownerId], references: [id])
  originalName String
  mimeType     String
  size         Int
  storageKey   String         @unique
  sha256       String
  width        Int?
  height       Int?
  variant      String         @default("original") // original, preview, thumb
  parentId     String?
  parent       FileAsset?     @relation("FileAssetVariants", fields: [parentId], references: [id], onDelete: Cascade)
  variants     FileAsset[]    @relation("FileAssetVariants")
  trashedAt    DateTime?
  destroyedAt  DateTime?
  isGlobal     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  uses         FileAssetUse[]
}

model FileAssetUse {
  id                String           @id @default(uuid())
  fileAssetId       String
  fileAsset         FileAsset        @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  documentVersionId String?
  documentVersion   DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  role              String // attachment, content_image, external_doc, avatar
  createdById       String
  createdBy         User             @relation("UseCreator", fields: [createdById], references: [id])
  createdAt         DateTime         @default(now())
}

// ─────────────────────────────────────────────
// Archiv & Vernichtung (Runde 7)
// ─────────────────────────────────────────────

model DestructionRequest {
  id                String          @id @default(uuid())
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  requestedById     String
  requestedBy       User            @relation("DestructionRequester", fields: [requestedById], references: [id])
  confirmedById     String?
  confirmedBy       User?           @relation("DestructionConfirmer", fields: [confirmedById], references: [id])
  status            String          @default("PENDING") // PENDING, EXECUTED, REJECTED
  comment           String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// ─────────────────────────────────────────────
// E-Mail-Vorlagen (Runde 8)
// ─────────────────────────────────────────────

model EmailTemplate {
  id        String   @id @default(cuid())
  event     String   @unique
  name      String
  subject   String
  bodyHtml  String
  bodyText  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
